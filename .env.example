# Create an API token in Proxmox: Datacenter > Permissions > API Tokens
# PROXMOX_TOKEN_USER format: user@realm  (e.g. root@pam or sync@pve)
PROXMOX_HOST=
PROXMOX_TOKEN_USER=netboxsync@pam
PROXMOX_TOKEN_ID=netbox-sync
PROXMOX_TOKEN_SECRET=

NETBOX_URL=
NETBOX_TOKEN=

# Optional — defaults shown
CLUSTER_NAME=Proxmox-Cluster
CLUSTER_TYPE_NAME=Proxmox
